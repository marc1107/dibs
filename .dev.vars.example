# Local development secrets. Copy to .dev.vars (git-ignored) and adjust.
# Production values are set with `wrangler secret put <NAME>`, see docs/SETUP.md.

# Any long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Google OAuth client (optional locally; the dev login below works without it).
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# From `pnpm vapid` (the public key goes into VAPID_PUBLIC_KEY below).
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY

# Cloudflare's official Turnstile test keys (always pass).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Local overrides of wrangler.jsonc vars.
APP_URL=http://localhost:5173
ADMIN_EMAIL=marc@example.com
TURNSTILE_SITE_KEY=1x00000000000000000000AA
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_SUBJECT=mailto:marc@example.com

# Enables /api/dev/login for local testing. Only honoured on localhost. NEVER set in production.
DEV_LOGIN=true
