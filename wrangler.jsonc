// Cloudflare Worker configuration. Values marked with "REPLACE_" are placeholders,
// see docs/SETUP.md for what to fill in. Secrets never go into this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schluesselbrett",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static assets (the React PWA). API, auth and iCal requests run through the Worker first;
  // everything else is served directly from the asset store with SPA fallback.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ical/*"]
  },

  // REPLACE_: your (sub)domain, e.g. "auto.example.com". The zone must be on Cloudflare DNS.
  "routes": [{ "pattern": "REPLACE_WITH_YOUR_DOMAIN", "custom_domain": true }],

  "vars": {
    // Public base URL of the app (used for OAuth callbacks, passkey RP ID and iCal links).
    "APP_URL": "https://REPLACE_WITH_YOUR_DOMAIN",
    // The Google account with this e-mail becomes admin automatically on first sign-in.
    "ADMIN_EMAIL": "REPLACE_WITH_ADMIN_EMAIL",
    // Cloudflare Turnstile site key (public). Create a widget in the Cloudflare dashboard.
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY",
    // Public VAPID key from `pnpm vapid`.
    "VAPID_PUBLIC_KEY": "REPLACE_WITH_VAPID_PUBLIC_KEY",
    // Contact for push services, "mailto:you@example.com".
    "VAPID_SUBJECT": "mailto:REPLACE_WITH_ADMIN_EMAIL"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schluesselbrett",
      // REPLACE_: output of `wrangler d1 create schluesselbrett`.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    // Private bucket for the weekly database export. `wrangler r2 bucket create schluesselbrett-backups`.
    { "binding": "BACKUPS", "bucket_name": "schluesselbrett-backups" }
  ],

  "ratelimits": [
    // 30 auth requests per minute per client IP.
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  "triggers": {
    // Every 15 minutes: reminders. Sundays 03:00 UTC: backup export to R2.
    "crons": ["*/15 * * * *", "0 3 * * 7"]
  }
}
