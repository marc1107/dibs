// Cloudflare Worker configuration. Values marked with "REPLACE_" are placeholders,
// see docs/SETUP.md for what to fill in. Secrets never go into this file (the repo is public):
// BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, VAPID_PRIVATE_KEY,
// TURNSTILE_SECRET_KEY and ADMIN_EMAIL are set with `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schluesselbrett",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static assets (the React PWA). API and iCal requests run through the Worker first;
  // everything else is served directly from the asset store with SPA fallback.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ical/*"]
  },

    "routes": [{ "pattern": "dibs.bohner.cloud", "custom_domain": true }],
  "workers_dev": false,

  "vars": {
    // Public base URL of the app (OAuth callback, passkey RP ID, iCal links).
    "APP_URL": "https://dibs.bohner.cloud",
    // Cloudflare Turnstile site key (public). Create a widget in the Cloudflare dashboard.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFpu8GIm7xAHo8mK",
    // Public VAPID key from `pnpm vapid`.
    "VAPID_PUBLIC_KEY": "BJmixzMloLNlKxiIBVr-iQSOaK1wrIE1m8bSPRxrgKn2xSGsPcSpCWCWh6Ld8ivxhUsYUhrREzdsi25ihV61TVE",
    // Contact for push services (a mailto: or https: URL).
    "VAPID_SUBJECT": "https://dibs.bohner.cloud"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schluesselbrett",
      "database_id": "0fe799cc-0586-4ebe-938c-0fd7abd6043b",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    // Private bucket for the weekly database export: `wrangler r2 bucket create schluesselbrett-backups`.
    { "binding": "BACKUPS", "bucket_name": "schluesselbrett-backups" }
  ],

  "ratelimits": [
    // 30 auth requests per minute per client IP.
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  "triggers": {
    // Every 15 minutes: reminders. Sundays 03:00 UTC: backup export to R2.
    "crons": ["*/15 * * * *", "0 3 * * 7"]
  },

  "env": {
    // PR previews (preview.yml): separate Worker and database, no cron jobs, no custom domain.
    "preview": {
      "name": "schluesselbrett-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "APP_URL": "https://schluesselbrett-preview.m-bohner99.workers.dev",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFpu8GIm7xAHo8mK",
        "VAPID_PUBLIC_KEY": "BJmixzMloLNlKxiIBVr-iQSOaK1wrIE1m8bSPRxrgKn2xSGsPcSpCWCWh6Ld8ivxhUsYUhrREzdsi25ihV61TVE",
        "VAPID_SUBJECT": "https://dibs.bohner.cloud"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "schluesselbrett-preview",
          "database_id": "5eb061f7-3eaf-40d6-a2d3-c2c366686e0e",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "schluesselbrett-backups" }],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
      ],
      "triggers": { "crons": [] }
    }
  }
}
